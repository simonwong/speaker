#!/bin/zsh

# Proves `sign-development` turns a validated ad-hoc bundle into one whose
# designated requirement names a certificate rather than a build hash, using a
# throwaway untrusted self-signed identity like the one CI imports. It adds a
# temporary keychain to the user search list, so it runs only on CI or when
# SPEAKER_ALLOW_KEYCHAIN_TEST=1.

set -euo pipefail

SCRIPT_DIR="${0:A:h}"
source "$SCRIPT_DIR/release-common"

if [[ "${CI:-}" != "true" && "${SPEAKER_ALLOW_KEYCHAIN_TEST:-0}" != "1" ]]; then
    print -u2 "test-sign-development edits the keychain search list; run it on CI or set SPEAKER_ALLOW_KEYCHAIN_TEST=1."
    exit 1
fi
SOURCE_APP="${SPEAKER_SIGN_TEST_APP:-}"
if [[ "$SOURCE_APP" != /* || ! -d "$SOURCE_APP" ]]; then
    print -u2 "SPEAKER_SIGN_TEST_APP must name an ad-hoc development Speaker.app."
    exit 1
fi

TEST_ROOT="$(mktemp -d "${TMPDIR:-/tmp}/speaker-sign-development.XXXXXX")"
TEST_ROOT="${TEST_ROOT:A}"
KEYCHAIN="$TEST_ROOT/signing.keychain-db"
KEYCHAIN_PASSWORD="$(/usr/bin/openssl rand -hex 16)"
ORIGINAL_KEYCHAINS=("${(@f)$(
    security list-keychains -d user | sed -E 's/^[[:space:]]*"(.*)"$/\1/'
)}")

cleanup() {
    security list-keychains -d user -s "${ORIGINAL_KEYCHAINS[@]}" || true
    security delete-keychain "$KEYCHAIN" 2>/dev/null || true
    rm -rf "$TEST_ROOT"
}
trap cleanup EXIT

print -r -- '[req]
distinguished_name = dn
x509_extensions = ext
prompt = no
[dn]
CN = Speaker Signing Test
[ext]
basicConstraints = critical,CA:false
keyUsage = critical,digitalSignature
extendedKeyUsage = critical,codeSigning' > "$TEST_ROOT/cert.cnf"
/usr/bin/openssl req -x509 -newkey rsa:2048 -nodes -days 2 \
    -config "$TEST_ROOT/cert.cnf" \
    -keyout "$TEST_ROOT/key.pem" \
    -out "$TEST_ROOT/cert.pem" 2>/dev/null
/usr/bin/openssl pkcs12 -export \
    -inkey "$TEST_ROOT/key.pem" \
    -in "$TEST_ROOT/cert.pem" \
    -out "$TEST_ROOT/identity.p12" \
    -passout pass:speaker-test

security create-keychain -p "$KEYCHAIN_PASSWORD" "$KEYCHAIN"
security unlock-keychain -p "$KEYCHAIN_PASSWORD" "$KEYCHAIN"
security import "$TEST_ROOT/identity.p12" \
    -k "$KEYCHAIN" -f pkcs12 -P speaker-test -T /usr/bin/codesign >/dev/null
security set-key-partition-list \
    -S apple-tool:,apple:,codesign: -s -k "$KEYCHAIN_PASSWORD" "$KEYCHAIN" >/dev/null
security list-keychains -d user -s "${ORIGINAL_KEYCHAINS[@]}" "$KEYCHAIN"

IDENTITY="$(single_code_signing_identity_hash \
    "$(security find-identity -p codesigning "$KEYCHAIN")")"

sign_copy() {
    local copy="$TEST_ROOT/$1/Speaker.app"

    mkdir -p "${copy:h}"
    /usr/bin/ditto "$SOURCE_APP" "$copy"
    SPEAKER_LOCAL_CODESIGN_IDENTITY="$IDENTITY" \
        /bin/zsh "$SCRIPT_DIR/sign-development" "$copy" >/dev/null
    print -r -- "$copy"
}

FIRST="$(sign_copy first)"
SECOND="$(sign_copy second)"

[[ "$(/usr/libexec/PlistBuddy -c 'Print :SpeakerSigningMode' \
    "$FIRST/Contents/Info.plist")" == "development-signed" ]]
codesign --verify --deep --strict "$FIRST"
FIRST_REQUIREMENT="$(codesign -d -r- "$FIRST" 2>&1 | grep '^designated => ')"
SECOND_REQUIREMENT="$(codesign -d -r- "$SECOND" 2>&1 | grep '^designated => ')"
[[ "$FIRST_REQUIREMENT" == *"certificate leaf = H\"${(L)IDENTITY}\""* ]] || {
    print -u2 "Re-signed bundle is not bound to the development certificate: $FIRST_REQUIREMENT"
    exit 1
}
[[ "$FIRST_REQUIREMENT" == "$SECOND_REQUIREMENT" ]] || {
    print -u2 "Two signings produced different designated requirements."
    exit 1
}

if /bin/zsh "$SCRIPT_DIR/sign-development" "$FIRST" >/dev/null 2>&1; then
    print -u2 "sign-development ran without an identity."
    exit 1
fi
if SPEAKER_LOCAL_CODESIGN_IDENTITY="$IDENTITY" \
    /bin/zsh "$SCRIPT_DIR/sign-development" "$FIRST" >/dev/null 2>&1; then
    print -u2 "sign-development re-signed a bundle that was not ad-hoc."
    exit 1
fi

print "PASS: development re-signing binds the designated requirement to one certificate"
