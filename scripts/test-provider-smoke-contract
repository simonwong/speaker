#!/bin/zsh

set -euo pipefail

SCRIPT_DIR="${0:A:h}"

# Every invocation below runs with the offline guard set. The deterministic gate
# must never be able to bill the user's Doubao or DeepSeek accounts, even if the
# tool's argument validation order regresses.
export SPEAKER_PROVIDER_SMOKE_NO_NETWORK=1
NO_NETWORK_STATUS=78

EVIDENCE_ROOT="$(mktemp -d "${TMPDIR:-/tmp}/speaker-smoke-contract.XXXXXX")"
trap 'rm -rf "$EVIDENCE_ROOT"' EXIT
FRESH_EVIDENCE_DIRECTORY="$EVIDENCE_ROOT/evidence"

set +e
matrix_output="$(/bin/zsh "$SCRIPT_DIR/provider-smoke" matrix 2>&1)"
matrix_status=$?
connection_output="$(/bin/zsh "$SCRIPT_DIR/provider-smoke" doubao unexpected 2>&1)"
connection_status=$?
missing_evidence_output="$(/bin/zsh "$SCRIPT_DIR/provider-smoke" matrix --confirm-paid-requests 2>&1)"
missing_evidence_status=$?
unsafe_keychain_output="$(/bin/zsh "$SCRIPT_DIR/provider-smoke" matrix --confirm-paid-requests --evidence-directory /private/tmp/new-evidence --candidate-version 1.2.3 --candidate-build 42 --keychain-service unsafe 2>&1)"
unsafe_keychain_status=$?
guarded_matrix_output="$(/bin/zsh "$SCRIPT_DIR/provider-smoke" matrix --confirm-paid-requests --evidence-directory "$FRESH_EVIDENCE_DIRECTORY" --candidate-version 1.2.3 --candidate-build 42 --keychain-service com.speaker.reviewed.provider-api-keys 2>&1)"
guarded_matrix_status=$?
guarded_connection_output="$(/bin/zsh "$SCRIPT_DIR/provider-smoke" all 2>&1)"
guarded_connection_status=$?
set -e

[[ "$matrix_status" == "64" ]] || {
    print -u2 "Provider matrix ran without explicit paid-request confirmation."
    exit 1
}
[[ "$matrix_output" == *"paid BYOK requests"* ]] || {
    print -u2 "Provider matrix did not explain its paid-request boundary."
    exit 1
}
[[ "$connection_status" == "64" ]] || {
    print -u2 "Connection probe accepted unexpected arguments."
    exit 1
}
[[ "$connection_output" == *"do not accept additional arguments"* ]] || {
    print -u2 "Connection probe did not report its argument boundary."
    exit 1
}
[[ "$missing_evidence_status" == "64" ]] || {
    print -u2 "Provider matrix ran without an evidence destination."
    exit 1
}
[[ "$missing_evidence_output" == *"fresh owner-only evidence directory"* ]] || {
    print -u2 "Provider matrix did not report its evidence boundary."
    exit 1
}
[[ "$unsafe_keychain_status" == "64" ]] || {
    print -u2 "Provider matrix accepted an unreviewed Keychain service shape."
    exit 1
}
[[ "$unsafe_keychain_output" == *"keychain-service"* ]] || {
    print -u2 "Provider matrix did not report its Keychain service boundary."
    exit 1
}

[[ "$guarded_matrix_status" == "$NO_NETWORK_STATUS" ]] || {
    print -u2 "A fully valid provider matrix invocation was not stopped by SPEAKER_PROVIDER_SMOKE_NO_NETWORK."
    exit 1
}
[[ "$guarded_matrix_output" == *"SPEAKER_PROVIDER_SMOKE_NO_NETWORK"* ]] || {
    print -u2 "Guarded provider matrix did not name the offline guard."
    exit 1
}
[[ "$guarded_matrix_output" != *"state=RUNNING"* ]] || {
    print -u2 "Guarded provider matrix started a provider case."
    exit 1
}
[[ ! -e "$FRESH_EVIDENCE_DIRECTORY" ]] || {
    print -u2 "Guarded provider matrix produced evidence, so it reached a provider."
    exit 1
}
[[ "$guarded_connection_status" == "$NO_NETWORK_STATUS" ]] || {
    print -u2 "A connection probe was not stopped by SPEAKER_PROVIDER_SMOKE_NO_NETWORK."
    exit 1
}
[[ "$guarded_connection_output" == *"SPEAKER_PROVIDER_SMOKE_NO_NETWORK"* ]] || {
    print -u2 "Guarded connection probe did not name the offline guard."
    exit 1
}
[[ "$guarded_connection_output" != *"state=RUNNING"* ]] || {
    print -u2 "Guarded connection probe started a provider case."
    exit 1
}

print "PASS: provider smoke requires paid confirmation and evidence binding, and never connects under SPEAKER_PROVIDER_SMOKE_NO_NETWORK"
