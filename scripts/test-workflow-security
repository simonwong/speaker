#!/bin/zsh

set -euo pipefail

SCRIPT_DIR="${0:A:h}"
ROOT="${SCRIPT_DIR:h}"
TEST_ROOT="$(mktemp -d "${TMPDIR:-/tmp}/speaker-workflow-security.XXXXXX")"
trap 'chmod -R -P u+w "$TEST_ROOT" 2>/dev/null || true; rm -rf "$TEST_ROOT"' EXIT

verify_workflows() {
    local directory="$1"
    local file
    local line
    local uses_value
    local revision
    local -a workflows=("$directory"/*.yml(N) "$directory"/*.yaml(N))

    (( ${#workflows} > 0 )) || {
        print -u2 "No workflow files were found."
        return 1
    }
    for file in "${workflows[@]}"; do
        grep -Eq '^permissions:$' "$file" \
            && grep -Eq '^  contents: read$' "$file" || {
            print -u2 "Workflow must declare top-level contents: read: ${file:t}"
            return 1
        }
        if grep -Eq '^[[:space:]]*pull_request_target:' "$file"; then
            print -u2 "pull_request_target is not allowed: ${file:t}"
            return 1
        fi
        if grep -Eq '^[[:space:]]*permissions:[[:space:]]*write-all' "$file"; then
            print -u2 "write-all workflow permissions are not allowed: ${file:t}"
            return 1
        fi
        while IFS= read -r line; do
            uses_value="$(
                print -r -- "$line" \
                    | sed -E 's/^[[:space:]]*(-[[:space:]]*)?uses:[[:space:]]*([^[:space:]#]+).*$/\2/'
            )"
            [[ "$uses_value" == ./* ]] && continue
            [[ "$uses_value" == *@* ]] || {
                print -u2 "Action reference has no revision: $uses_value"
                return 1
            }
            revision="${uses_value##*@}"
            print -r -- "$revision" | grep -Eq '^[0-9a-f]{40}$' || {
                print -u2 "Action is not pinned to a full commit SHA: $uses_value"
                return 1
            }
        done < <(
            grep -E '^[[:space:]]*(-[[:space:]]*)?uses:' "$file" || true
        )
    done
}

verify_production_release_publication() {
    local file="$1"
    local create_line
    local download_line
    local promote_line
    local readback_line
    local upgrade_gate_line
    local release_job
    local stage_job
    local publish_job

    release_job="$(sed -n '/^  release:/,/^  stage:/p' "$file")"
    stage_job="$(sed -n '/^  stage:/,/^  publish:/p' "$file")"
    publish_job="$(sed -n '/^  publish:/,$p' "$file")"
    [[ "$release_job" != *'contents: write'* ]] || {
        print -u2 "Build and signing job must not receive contents: write."
        return 1
    }
    print -r -- "$stage_job" | grep -Eq '^    environment: production-staging$' \
        && print -r -- "$stage_job" | grep -Eq '^      contents: write$' || {
        print -u2 "Candidate staging must use scoped contents: write."
        return 1
    }
    print -r -- "$stage_job" \
        | grep -Fq "inputs.upgrade_evidence_file == ''" || {
        print -u2 "Candidate staging must run only before upgrade evidence exists."
        return 1
    }
    print -r -- "$publish_job" | grep -Eq '^    permissions:$' \
        && print -r -- "$publish_job" | grep -Eq '^      contents: write$' || {
        print -u2 "Production release job must have scoped contents: write."
        return 1
    }
    print -r -- "$publish_job" \
        | grep -Eq '^    environment: production-publication$' || {
        print -u2 "Production publication must use its own reviewed environment."
        return 1
    }
    [[ "$publish_job" != *'SPEAKER_SPARKLE_PRIVATE_KEY'* ]] || {
        print -u2 "Production publication must not receive the Sparkle private key."
        return 1
    }
    print -r -- "$publish_job" \
        | grep -Fq "inputs.upgrade_evidence_file != '' && inputs.candidate_run_id != ''" || {
        print -u2 "Production publication requires evidence and the candidate run ID."
        return 1
    }
    for contract in \
        'gh release create "$TAG"' \
        'gh release download "$TAG"' \
        'gh release edit "$TAG"' \
        '--prerelease' \
        '--prerelease=false' \
        '--latest' \
        'run-id: ${{ inputs.candidate_run_id }}' \
        'resolve_reviewed_upgrade_evidence' \
        'reviewed_release_promotion_state' \
        'verify_reviewed_upgrade_candidate' \
        'SpeakerReleaseEvidenceProtector' \
        '-evidence.zip.enc' \
        './scripts/verify-published-update'
    do
        grep -F -- "$contract" "$file" >/dev/null || {
            print -u2 "Production release workflow is missing: $contract"
            return 1
        }
    done
    create_line="$(grep -nF 'gh release create "$TAG"' "$file" | head -n 1 | cut -d: -f1)"
    download_line="$(grep -nF 'gh release download "$TAG"' "$file" | tail -n 1 | cut -d: -f1)"
    promote_line="$(grep -nF 'gh release edit "$TAG"' "$file" | head -n 1 | cut -d: -f1)"
    readback_line="$(grep -nF './scripts/verify-published-update' "$file" | head -n 1 | cut -d: -f1)"
    upgrade_gate_line="$(grep -nF 'resolve_reviewed_upgrade_evidence' "$file" | tail -n 1 | cut -d: -f1)"
    (( create_line < upgrade_gate_line \
        && upgrade_gate_line < download_line \
        && download_line < promote_line \
        && promote_line < readback_line )) || {
        print -u2 "The staged candidate must be evidence-bound before exact-artifact promotion and public readback."
        return 1
    }
    if grep -Eq '^[[:space:]]+\.build/distribution/.*-evidence\.zip(\.sha256)?$' "$file"; then
        print -u2 "Plaintext release evidence must not be retained by public-repo Actions."
        return 1
    fi
}

mkdir "$TEST_ROOT/valid" "$TEST_ROOT/unpinned" \
    "$TEST_ROOT/target" "$TEST_ROOT/write-all"
print -r -- 'name: valid
on: push
permissions:
  contents: read
jobs:
  verify:
    steps:
      - uses: actions/checkout@de0fac2e4500dabe0009e67214ff5f5447ce83dd
      - uses: ./local-action' > "$TEST_ROOT/valid/ci.yml"
print -r -- 'name: unpinned
on: push
permissions:
  contents: read
jobs:
  verify:
    steps:
      - uses: actions/checkout@v6' > "$TEST_ROOT/unpinned/ci.yml"
print -r -- 'name: target
on:
  pull_request_target:
permissions:
  contents: read
jobs: {}' > "$TEST_ROOT/target/ci.yml"
print -r -- 'name: write-all
on: push
permissions: write-all
jobs: {}' > "$TEST_ROOT/write-all/ci.yml"

verify_workflows "$TEST_ROOT/valid"
if verify_workflows "$TEST_ROOT/unpinned" >/dev/null 2>&1; then
    print -u2 "Workflow gate accepted a movable Action tag."
    exit 1
fi
if verify_workflows "$TEST_ROOT/target" >/dev/null 2>&1; then
    print -u2 "Workflow gate accepted pull_request_target."
    exit 1
fi
if verify_workflows "$TEST_ROOT/write-all" >/dev/null 2>&1; then
    print -u2 "Workflow gate accepted write-all permissions."
    exit 1
fi
verify_workflows "$ROOT/.github/workflows"
verify_production_release_publication "$ROOT/.github/workflows/release.yml"

print "PASS: workflows use least privilege and immutable Action revisions"
