#!/bin/zsh

# Re-signs a validated ad-hoc development bundle with the stable identity in
# SPEAKER_LOCAL_CODESIGN_IDENTITY, so published development builds keep their
# macOS Microphone and Accessibility grants across upgrades.

set -euo pipefail

SCRIPT_DIR="${0:A:h}"
source "$SCRIPT_DIR/release-common"

APP="${1:-}"
IDENTITY="${SPEAKER_LOCAL_CODESIGN_IDENTITY:-}"

if [[ $# -ne 1 || "$APP" != /* || "$APP" != *.app \
      || ! -d "$APP" || -L "$APP" ]]; then
    print -u2 "Usage: SPEAKER_LOCAL_CODESIGN_IDENTITY=<identity> $0 /absolute/path/Speaker.app"
    exit 1
fi
if [[ -z "$IDENTITY" || "$IDENTITY" == "-" ]]; then
    print -u2 "SPEAKER_LOCAL_CODESIGN_IDENTITY must name a stable code-signing identity."
    exit 1
fi

PLIST="$APP/Contents/Info.plist"
SIGNING_MODE="$(/usr/libexec/PlistBuddy -c 'Print :SpeakerSigningMode' "$PLIST")"
STORAGE_KIND="$(/usr/libexec/PlistBuddy -c 'Print :SpeakerCredentialStorage' "$PLIST")"
BUNDLE_IDENTIFIER="$(/usr/libexec/PlistBuddy -c 'Print :CFBundleIdentifier' "$PLIST")"

if [[ "$SIGNING_MODE" != "development-ad-hoc" || "$STORAGE_KIND" != "local-file" ]]; then
    print -u2 "Only an ad-hoc development bundle can be re-signed; found $SIGNING_MODE/$STORAGE_KIND."
    exit 1
fi
verify_ad_hoc_app "$APP" "$BUNDLE_IDENTIFIER"
sign_development_app "$APP" "$IDENTITY" "$BUNDLE_IDENTIFIER"
verify_sparkle_layout "$APP"
print "$APP"
