#!/bin/zsh

set -euo pipefail

SCRIPT_DIR="${0:A:h}"
ROOT="${SCRIPT_DIR:h}"
OUTPUT_DIRECTORY="${1:-$ROOT/Resources}"
OUTPUT_DIRECTORY="${OUTPUT_DIRECTORY:A}"
WORK_DIRECTORY="$(mktemp -d "${TMPDIR:-/tmp}/speaker-brand-assets.XXXXXX")"

cleanup() {
    rm -rf "$WORK_DIRECTORY"
}
trap cleanup EXIT

"$SCRIPT_DIR/swiftw" run --disable-sandbox \
    SpeakerBrandAssetGenerator "$WORK_DIRECTORY"

mkdir -p "$OUTPUT_DIRECTORY"
cp "$WORK_DIRECTORY/AppIcon.png" "$OUTPUT_DIRECTORY/AppIcon.png"
cp "$WORK_DIRECTORY/AppIcon.icns" "$OUTPUT_DIRECTORY/AppIcon.icns"
