#!/bin/zsh

set -euo pipefail

SCRIPT_DIR="${0:A:h}"
ROOT="${SCRIPT_DIR:h}"
TEST_ROOT="$(mktemp -d "${TMPDIR:-/tmp}/speaker-brand-assets-test.XXXXXX")"

cleanup() {
    rm -rf "$TEST_ROOT"
}
trap cleanup EXIT

"$SCRIPT_DIR/generate-brand-assets" "$TEST_ROOT"

verify_pixels() {
    local actual="$1"
    local expected="$2"

    "$SCRIPT_DIR/swiftw" run --disable-sandbox \
        SpeakerBrandAssetGenerator \
        --verify-pixels \
        "$actual" \
        "$expected"
}

verify_pixels \
    "$TEST_ROOT/AppIcon.png" \
    "$ROOT/Resources/AppIcon.png"

MUTATED_ICON="$TEST_ROOT/AppIcon-mutated.png"
sips --flip horizontal \
    "$ROOT/Resources/AppIcon.png" \
    --out "$MUTATED_ICON" >/dev/null
if verify_pixels \
    "$ROOT/Resources/AppIcon.png" \
    "$MUTATED_ICON" >/dev/null 2>&1; then
    print -u2 "A meaningful brand artwork change passed pixel verification."
    exit 1
fi

iconutil -c iconset \
    "$TEST_ROOT/AppIcon.icns" \
    -o "$TEST_ROOT/Generated.iconset"
iconutil -c iconset \
    "$ROOT/Resources/AppIcon.icns" \
    -o "$TEST_ROOT/CheckedIn.iconset"
for generated_icon in "$TEST_ROOT/Generated.iconset"/*.png; do
    icon_name="${generated_icon:t}"
    [[ -s "$TEST_ROOT/CheckedIn.iconset/$icon_name" ]]
done
for checked_in_icon in "$TEST_ROOT/CheckedIn.iconset"/*.png; do
    icon_name="${checked_in_icon:t}"
    [[ -s "$TEST_ROOT/Generated.iconset/$icon_name" ]]
done
cmp \
    "$TEST_ROOT/AppIcon.png" \
    "$TEST_ROOT/Generated.iconset/icon_512x512@2x.png"
cmp \
    "$ROOT/Resources/AppIcon.png" \
    "$TEST_ROOT/CheckedIn.iconset/icon_512x512@2x.png"

print "PASS: checked-in Speaker brand assets match the canonical vector"
